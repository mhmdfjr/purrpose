rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny-all — M0 skeleton
    // Per-collection rules akan diisi bertahap mulai M2 sesuai DATABASE.md Section 9
    // Saat ini semua read/write ditolak dari client; hanya Admin SDK (Cloud Functions) yang bisa write.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
